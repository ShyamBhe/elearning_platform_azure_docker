# Copy to .env and change every value marked CHANGE.
POSTGRES_PASSWORD=CHANGE-me-to-a-long-random-string
SECRET_KEY=CHANGE-me-run-openssl-rand-hex-32
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=CHANGE-me-1234

# Production only: the public host name Caddy serves and gets a TLS certificate for.
# With the Azure DNS label from infra/azure/provision.sh this looks like courseway-abc.northeurope.cloudapp.azure.com
DOMAIN=localhost
